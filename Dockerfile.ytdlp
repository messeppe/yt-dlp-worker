FROM python:3.11-slim

# Deno for yt-dlp EJS (nsig/sig). No ffmpeg — we store bv+ba separately.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates unzip git nodejs npm \
    && curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh \
    && deno --version \
    && rm -rf /var/lib/apt/lists/*

# Optional bgutil POT HTTP server (ENABLE_BGUTIL=1). Generates PO tokens without Google login.
# Pin server tag to the same release as the pip plugin — floating main caused
# ImportError: cannot import name 'BgUtilPTPBase' (plugin/server skew).
ARG BGUTIL_VERSION=1.3.1
RUN git clone --depth 1 --branch "${BGUTIL_VERSION}" \
      https://github.com/Brainicism/bgutil-ytdlp-pot-provider.git /bgutil \
    && cd /bgutil/server \
    && npm ci \
    && npx tsc

COPY requirements_ytdlp.txt .
RUN pip install --no-cache-dir -r requirements_ytdlp.txt \
    && python -c "from yt_dlp_plugins.extractor.getpot_bgutil import BgUtilPTPBase; print('bgutil plugin OK', BgUtilPTPBase)" \
    && yt-dlp --version

WORKDIR /app
COPY logging_setup.py proxy_pool.py worker_ytdlp.py start.sh ./
RUN chmod +x start.sh

ENV YTDLP_JS_RUNTIME=deno
ENV PATH="/usr/local/bin:${PATH}"

CMD ["./start.sh"]
